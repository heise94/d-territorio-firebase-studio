# Names only. Supply legitimate values through environment-specific Secret Manager.
CAMPAIGNS_ENV=
CAMPAIGNS_STAGING_PROJECT_ID=
CAMPAIGNS_PRODUCTION_PROJECT_ID=
CAMPAIGNS_APP_ORIGIN=
CAMPAIGNS_HOST_ROUTING=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
# App Hosting uses its service account / ADC. Do not export private keys there.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
CAMPAIGNS_AUTH_SECRET=
CAMPAIGNS_AUTH_REGISTER_GLOBAL_LIMIT=160
CAMPAIGNS_AUTH_LOGIN_GLOBAL_LIMIT=240
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
CAMPAIGNS_TIME_ZONE=America/Santiago
NEXT_PUBLIC_CAMPAIGNS_TIME_ZONE=America/Santiago
CAMPAIGNS_NOTIFICATION_JOB_SECRET=
# Set from the actual release, not the date this template was created.
CAMPAIGNS_BUILD_SHA=
CAMPAIGNS_DEPLOYED_AT=
