rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows the invitation page to check if an email exists
    // before a user is logged in. This is the only public access.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other collections require a user to be logged in to read or write.
    match /{path=**}/documents/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
