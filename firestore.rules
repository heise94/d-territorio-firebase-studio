rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow unauthenticated reads on the users collection to verify invitation emails.
    // WARNING: In a production app, this should be made more secure, for example by using
    // a Cloud Function for the email check to prevent listing all user data.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Secure all other top-level collections
    match /territories/{docId} {
      allow read, write: if request.auth != null;
    }
    match /casas/{docId} {
      allow read, write: if request.auth != null;
    }
    match /preachingGroups/{docId} {
      allow read, write: if request.auth != null;
    }
    match /assignments/{docId} {
      allow read, write: if request.auth != null;
    }
    match /groupAssignments/{docId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }
    match /settings/{setting} {
      allow read, write: if request.auth != null;
    }
  }
}
