rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // REGLA PÚBLICA: Permite leer la colección 'users' para verificar
    // el email en la página de invitación, incluso sin iniciar sesión.
    // Las escrituras siguen protegidas.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // REGLAS PROTEGIDAS: Para todas las demás colecciones, se requiere
    // que el usuario haya iniciado sesión para cualquier operación.
    match /territories/{docId} { allow read, write: if request.auth != null; }
    match /casas/{docId} { allow read, write: if request.auth != null; }
    match /assignments/{docId} { allow read, write: if request.auth != null; }
    match /groupAssignments/{docId} { allow read, write: if request.auth != null; }
    match /preachingGroups/{docId} { allow read, write: if request.auth != null; }
    match /settings/{docId} { allow read, write: if request.auth != null; }
    match /notifications/{docId} { allow read, write: if request.auth != null; }

    // Configuración de campañas: requiere una claim administrativa explícita.
    // La UI además exige el permiso existente MANAGE_CAMPAIGNS.
    function isCampaignAdmin() { return request.auth != null && request.auth.token.campaign_admin == true; }
    match /campaigns/{docId} { allow read, write: if isCampaignAdmin(); }
    match /campaignDays/{docId} { allow read, write: if isCampaignAdmin(); }
    match /timeBlocks/{docId} { allow read, write: if isCampaignAdmin(); }
    match /congregations/{docId} { allow read, write: if isCampaignAdmin(); }
    match /campaignCongregations/{docId} { allow read, write: if isCampaignAdmin(); }
    match /points/{docId} { allow read, write: if isCampaignAdmin(); }

    // Participant authentication is exclusively server-side (Firebase Admin).
    // Even authenticated organizers cannot directly retrieve credential/session documents.
    match /participants/{docId} { allow read, write: if false; }
    match /deviceSessions/{docId} { allow read, write: if false; }
    match /campaignParticipantPhones/{docId} { allow read, write: if false; }
    match /campaignAuthLimits/{docId} { allow read, write: if false; }
    match /auditLogs/{docId} { allow read, write: if false; }
    match /campaignRegistrations/{docId} { allow read, write: if false; }
    match /availabilities/{docId} { allow read, write: if false; }
    match /pairRequests/{docId} { allow read, write: if false; }
    match /campaignPairRequestLocks/{docId} { allow read, write: if false; }
  }
}
