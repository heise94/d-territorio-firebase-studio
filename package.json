{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "rm -rf .next && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:campaign-auth": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-auth/*.test.ts",
    "test:campaign-registration": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-registration/*.test.ts",
    "test:campaign-pair-requests": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-pair-requests/*.test.ts",
    "test:campaign-admin-dashboard": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-admin-dashboard/*.test.ts",
    "test:campaign-planner": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-planner/*.test.ts",
    "test:campaign-program": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-program/*.test.ts",
    "test:campaign-changes": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-changes/*.test.ts",
    "test:campaign-notifications-pwa": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-notifications-pwa/*.test.ts",
    "test:campaign-pilot": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test --test-concurrency=1 tests/campaign-pilot/*.test.ts",
    "test:campaign-deployment": "node --require ./tests/campaign-auth/server-only.cjs --import tsx --test tests/campaign-deployment/*.test.ts",
    "check:campaign-deployment": "tsx scripts/campaign-deployment-check.ts",
    "provision:campaign-organizer": "tsx scripts/campaign-organizer-provision.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.7",
    "@genkit-ai/googleai": "^1.8.0",
    "@genkit-ai/next": "^1.8.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack-query-firebase/react": "^1.0.5",
    "@tanstack/react-query": "^5.66.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "firebase": "^11.8.1",
    "firebase-admin": "^14.5.0",
    "genkit": "^1.8.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.475.0",
    "next": "15.5.27",
    "papaparse": "^5.4.1",
    "patch-package": "^8.0.0",
    "pdfkit": "0.20.2",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "genkit-cli": "^1.8.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
